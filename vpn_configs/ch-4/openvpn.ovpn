client
remote 87-1-us.cg-dialup.net 443
dev tun 
proto udp


resolv-retry infinite 
redirect-gateway def1
persist-key
persist-tun
nobind
cipher AES-256-CBC
ncp-disable
auth SHA256
ping 5
ping-exit 60
ping-timer-rem
explicit-exit-notify 2
script-security 2
remote-cert-tls server
route-delay 5
verb 4


auth-user-pass /vpn_config/creds
dhcp-option DNS 1.1.1.1

ca /vpn_config/ca.crt

cert /vpn_config/client.crt

key /vpn_config/client.key
